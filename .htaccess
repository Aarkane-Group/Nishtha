Options -Indexes
RewriteEngine On

# Never serve internals
RewriteRule ^(app|storage|src|drizzle|supabase|nishthaglobal1|\.lovable|\.vscode)(/|$) - [F,L]
RewriteRule ^(config|AGENTS|roadmap|README)\.(md|php)$ - [F,L]

# Real files (assets, images, favicon) are served directly; everything else goes to the front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
